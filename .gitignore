# Local secrets. An .env beside a compose file in containers/ holds values
# such as YF_MCP_BEARER_TOKEN, the example next to it is the tracked template.
# The patterns carry no slash, so they match in every folder.
.env
.env.*
!.env.example
# Certificates and keys for the compose profile https (secrets/tls/).
secrets/
# Claude Code's per-machine permissions. Local by convention, and hatchling
# puts every file .gitignore does not exclude into a locally built sdist.
.claude/settings.local.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
