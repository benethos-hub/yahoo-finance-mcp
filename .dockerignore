# Keep the build context small and reproducible.
.git
.github
.gitignore
.gitattributes
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.cache
*.sqlite

# Local secrets never belong in the build context, not even the template
.env
.env.*

# Not needed inside the image
tests
SPECS.md
CLAUDE.md
Dockerfile
.dockerignore

# Build and tool output. Nothing here is copied into the image, but a stale
# wheel in dist/ or a tool cache has no business in the build context either.
dist
build
.coverage
htmlcov
.mypy_cache
.ruff_cache
.claude
