# Template for the .env beside compose.yaml. Copy it to .env and fill in what
# you need. .env is ignored by git and by the Docker build context, so a secret
# set here stays on this machine.
#
# Compose reads two kinds of values from it. COMPOSE_PROFILES and the
# YAHOO_FINANCE_MCP_* names below are for compose itself and for Caddy: the
# image version, the port on the host and HTTPS. Everything else is handed
# to the server through `env_file`. The server never
# loads this file: run locally or from Claude Desktop, it takes its settings
# from the environment and the command line as before.
#
# A value set under `environment:` in compose.yaml wins over the same name here.

# The version of the image, required. An exact version (X.Y.Z) stays put, a
# minor line (X.Y) follows its patch releases. To update, change it, then
#   docker compose pull && docker compose up -d
YAHOO_FINANCE_MCP_VERSION=0.8.8

# The port on the host, on 127.0.0.1 only.
# YAHOO_FINANCE_MCP_PORT=8000

# HTTPS for clients on the local network: set `https` here and Caddy starts
# in front of the server with a plain `up`, on ports 80 and 443 of every
# address of this host. Empty, only the server runs, on the loopback. With
# `https` the bearer token below is required, since the server is then
# reachable from wherever this host is.
COMPOSE_PROFILES=

# The name clients use, e.g. finance.lan. Required with `https`. It has to
# resolve to this host on the clients, through the local DNS or a hosts file.
YAHOO_FINANCE_MCP_DOMAIN=

# Where its certificate comes from:
#   internal  Caddy's own CA. Every client trusts its root once, see
#             containers/README.md. For the local network, and the default.
#   files     your own, as secrets/tls/cert.pem and secrets/tls/key.pem in
#             this folder, a company CA's for instance. secrets/ is ignored
#             by git.
#   acme      a public CA. Needs the name in public DNS and this host
#             reachable from the internet on ports 80 and 443.
YAHOO_FINANCE_MCP_TLS=internal

# Require a bearer token on every HTTP request, required with `https`. Long
# and random, e.g. the output of
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# YF_MCP_BEARER_TOKEN=

# Anything else from the README's configuration table works here too, e.g.:
# YF_MCP_CACHE=1
# YF_MCP_CACHE_MAX_ENTRIES=10000

# The log writes local time with its offset. A container runs on UTC unless
# this is set.
# TZ=Europe/Berlin

# Not here: YF_MCP_ALLOWED_HOSTS and YF_MCP_CACHE_DIR. compose.yaml sets both
# under `environment:`, which wins over this file, and appends the domain
# above to the allowed hosts on its own. Another name goes in there.
